<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Deterministic>True</Deterministic>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <RepositoryUrl>https://github.com/mrb0nj/Slack.Webhooks.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageId>Slack.Webhooks</PackageId>
        <Authors>mrb0nj and contributors</Authors>
        <Description>A lightweight .NET client for sending messages to Slack incoming webhooks, including support for attachments and Block Kit message blocks.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>slack.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>Slack;Webhooks</PackageTags>
        <PackageReleaseNotes>Adds Slack webhook unfurl options, fixes plain-text input multiline serialization, and keeps modern NuGet package metadata.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath=""/>
        <None Include="..\..\slack.png" Pack="true" PackagePath=""/>
    </ItemGroup>

</Project>
